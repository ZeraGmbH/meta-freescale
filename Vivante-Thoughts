mesa:
/usr/lib/dri/etnaviv_dri.so

Section "Device"
    Identifier "Default Device"
    Driver     "modesetting"
    Option     "kmsdev"      "/dev/dri/card0"
    Option     "AccelMethod" "glamor"
    Option     "Atomic"      "On"
EndSection

Section "ServerFlags"
    Option     "AutoAddGPU"  "false"
    Option     "DRI"         "3"
EndSection

